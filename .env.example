# Server port configuration (customize per worktree to avoid port collisions, e.g. 3001)
PORT=3000

# Optional LLM Model Gateway configuration
# Default provider for non-admin requests: "gemini" (default) or "melious" (OpenAI /v1/chat/completions compatible)
# LLM_PROVIDER=gemini
# Provider API keys (if set, exposed to admin sessions and test page provider dropdown)
# If no API key is set in debug mode, the server runs with the local deterministic EchoPromptRunner fallback
# GEMINI_API_KEY=
# MELIOUS_API_KEY=
# Optional endpoint and model tier overrides:
# LLM_BASE_URL=
# LLM_MODEL_FAST=
# LLM_MODEL_LARGE=

# Optional Admin bearer token / cookie session authentication
# ADMIN_TOKEN=admin

# Optional environment mode ("production" or "staging")
# ENVIRONMENT=production
