# Server port configuration (customize per worktree to avoid port collisions, e.g. 3001)
PORT=3000

# Optional Gemini API key for LLM translation and transcript correction
# If not set, the server runs with the local deterministic EchoPromptRunner fallback
# GEMINI_API_KEY=

# Optional Admin bearer token / cookie session authentication
# ADMIN_TOKEN=admin

# Optional environment mode ("production" or "staging")
# ENVIRONMENT=production
